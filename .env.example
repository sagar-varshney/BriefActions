# Local development defaults to a private loopback workspace with SQLite.
# Public deployments require the settings below, NODE_ENV=production,
# and all SQL files in deploy/migrations, applied in numeric order.
NODE_ENV=production
# On Render, omit PUBLIC_ORIGIN to use its assigned RENDER_EXTERNAL_URL.
# Set it explicitly for a custom domain or a different host.
PUBLIC_ORIGIN=https://your-app.onrender.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only secret for deleting the authenticated user's sign-in account.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Use the Supabase session pooler connection URL; keep this server-side.
FLOW_DATABASE_URL=postgresql://postgres.your-project:URL_ENCODED_PASSWORD@pooler-host:5432/postgres?sslmode=require
# Enable only after configuring custom SMTP and Supabase redirect allowlists.
FLOW_EMAIL_SIGNIN=false
HOST=0.0.0.0
PORT=3001

# Analysis lane size; one additional lightweight worker serves reads/saves.
# CI checks both lanes together under 512 MiB / 0.1 CPU.
FLOW_MAX_WORKERS=1
# Structured, transcript-free failure logs and runtime counters in host logs.
FLOW_TELEMETRY=true
